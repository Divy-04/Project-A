# Copy to .env.local and fill in. .env* is gitignored, so real values never
# reach the repository. Set the same two on the host once deployment is
# decided (Cloudflare Pages / Netlify / Vercel all take environment variables).

# --- Enquiry form → Telegram -------------------------------------------------
# The form on /contact posts to /api/enquiry, which relays to Telegram. Both
# values are read on the SERVER only — putting the token anywhere the browser
# can see it would let anyone take the bot over.
#
# 1. Message @BotFather on Telegram, /newbot, and copy the token it gives you.
# 2. Send your new bot any message.
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy
#    result[0].message.chat.id — that is the chat id.
#    (For a group instead: add the bot to the group, post a message, same URL.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Site -------------------------------------------------------------------
# The real domain. Canonical URLs, the sitemap, robots.txt and the
# LocalBusiness structured data all build off this. TBC.
NEXT_PUBLIC_SITE_URL=https://aadienterprise.com
